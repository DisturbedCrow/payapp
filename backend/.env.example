# SetuPay backend — demo-day configuration.
# Copy to backend/.env (gitignored) and adjust. Every value has a safe default,
# so the stack boots with none of this set.

APP_NAME=SetuPay

# JWT secret — use a strong random value in production
SECRET_KEY=hackathon-offline-pay-secret-2024

# Database
# Local:      sqlite:///./offline_pay.db
# Production: postgresql://user:pass@host/dbname  (Render injects this automatically)
DATABASE_URL=sqlite:///./offline_pay.db

# Ed25519 server signing key (base64-encoded raw 32-byte private key).
# Leave empty locally — a key is generated and saved to keys/ed25519.key.
# In production: copy the value printed in the logs on first deploy.
ED25519_PRIVATE_KEY_B64=

# Fraud rules reject (true) rather than flag-only (false).
DEMO_MODE=true

# log_only → signature failures are logged + shown on the ops dashboard but the
#            blob still settles. Safe while the demo phones are being provisioned.
# enforce  → signature failures reject the blob.
# Flip to `enforce` only once BOTH demo phones show `settled (signature verified)`
# on the dashboard. `python -m demo.attack forge` requires `enforce`.
SIGNATURE_ENFORCEMENT=enforce

# Live ops dashboard: http://<host>:8000/dashboard/live?token=<this>
OPS_DASH_TOKEN=setupay-demo

# ── GenAI: risk explainer (D) + voice intent garnish (G6) ─────────────
# Providers: gemini | anthropic | mock
# `mock` needs no key and is ALWAYS the fallback — every live provider
# degrades to it silently on timeout, error, or a malformed reply, so the
# app is fully functional with none of this set.
EXPLAINER_PROVIDER=gemini

# Gemini (default). flash-lite is the cheapest tier and is comfortably
# sufficient: both jobs are short, structured extractions. Measured ~1.2-1.6s
# for these prompts. `-latest` tracks the current cheapest flash-lite instead
# of pinning a version that eventually gets retired.
#   Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Ceiling for any live LLM call. 3.0s because flash-lite averages ~1.2s and
# 2.0s left no headroom on a bad network; a miss is invisible (instant
# template fallback), it just loses the "AI" badge on that render.
LLM_TIMEOUT_SECONDS=3.0
EXPLAINER_CACHE_TTL_SECONDS=300

# Velocity rule (Feature F): max offline blobs per sender per window.
VELOCITY_MAX_BLOBS=5
VELOCITY_WINDOW_MIN=10

# Times shown to users (rejection copy) are rendered in this zone.
DISPLAY_TZ=Asia/Kolkata
